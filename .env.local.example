# Copy this file to .env.local and fill in your Supabase project values.
# Found in Supabase Dashboard -> Project Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. From resend.com/api-keys. Without a verified custom
# domain, Resend only allows sending to the account owner's own email -
# notifications to other recipients will fail (gracefully - the app
# logs the error and continues, it doesn't crash).
RESEND_API_KEY=

# Server-only. From aistudio.google.com -> Get API key. Must start
# with "AIza" - a token in a different format will fail to authenticate.
GEMINI_API_KEY=
CRON_SECRET=your-random-secret-here
